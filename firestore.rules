rules_version = '2';

// Security rules for Nossos Momentos.
//
// Membership and role are enforced on the timeline doc:
//   - `emails`  : list of every member's email;
//   - `owners`  : list of owner emails (gate for deleting the timeline);
//   - `roles`   : map email -> 'owner' | 'editor' | 'viewer' (gate for editing
//                 moments).
//
// IMPORTANT: deploying this file REPLACES the rules currently in the Firebase
// console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /time_line/{timelineId} {
      function isMember() {
        return userEmail() in resource.data.emails;
      }
      function isOwner() {
        return userEmail() in resource.data.owners;
      }
      // Membership/ownership fields may only be changed by owners; a plain
      // member must not touch these (otherwise any editor could self-promote to
      // owner via update({'roles': ..., 'owners': ...})).
      function touchesSensitiveFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['roles', 'owners', 'emails']);
      }
      allow read: if isMember();
      allow update: if isMember() && (isOwner() || !touchesSensitiveFields());
      allow delete: if isOwner();
      allow create: if isSignedIn();
    }

    match /moments/{momentId} {
      // On reads/updates/deletes the doc exists, so resource.data is valid.
      // On create the doc does not exist yet; use request.resource.data instead.
      function timelineId() {
        return resource == null
          ? request.resource.data.time_line_id
          : resource.data.time_line_id;
      }
      function timelineData() {
        return get(/databases/$(database)/documents/time_line/$(timelineId())).data;
      }
      function isMemberOfTimeline() {
        return userEmail() in timelineData().emails;
      }
      function canEditInTimeline() {
        // roles[email] absent means the app defaults to 'editor' — mirror that here.
        let role = timelineData().roles.get(userEmail(), 'editor');
        return role in ['owner', 'editor'];
      }
      // A moment is private when visibility == 'private'; only its author may
      // read it. Legacy docs have no `visibility` field, so a missing value
      // defaults to 'shared' (mirrors MomentModel._visibilityFromJson).
      function isVisibleToMe() {
        return resource.data.get('visibility', 'shared') != 'private'
          || resource.data.get('author', '') == userEmail();
      }
      // Split get/list on purpose: a single-doc `get` enforces per-moment
      // privacy, so another member can't fetch someone's private moment by id.
      // `list` stays member-scoped because adding the privacy predicate here
      // would reject the whole feed query whenever it spans a private moment
      // authored by someone else; the client filters those out (see
      // NewFeedCubit). Full list-level enforcement would need a backfill of
      // `visibility` on every doc plus an OR-filtered query.
      allow get: if isMemberOfTimeline() && isVisibleToMe();
      allow list: if isMemberOfTimeline();
      allow create: if isSignedIn() && isMemberOfTimeline() && canEditInTimeline();
      allow update, delete: if isMemberOfTimeline() && canEditInTimeline();

      // Recursive: covers moments/<id>/reactions/** and moments/<id>/comments/**.
      // A signed-in check is not enough here — the subcollection must inherit
      // the parent moment's timeline membership, otherwise any authenticated
      // user could read/write another couple's reactions and comments.
      match /{subcollection}/{docId} {
        function parentMomentData() {
          return get(/databases/$(database)/documents/moments/$(momentId)).data;
        }
        function parentTimelineData() {
          return get(/databases/$(database)/documents/time_line/$(parentMomentData().time_line_id)).data;
        }
        function isMemberOfParentTimeline() {
          return userEmail() in parentTimelineData().emails;
        }
        allow read: if isMemberOfParentTimeline();
        allow write: if isMemberOfParentTimeline();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
